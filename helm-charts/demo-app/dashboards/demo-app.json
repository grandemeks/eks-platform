{
  "title": "demo-app - Golden Signals & SLO",
  "uid": "demo-app-golden-signals",
  "tags": [
    "eks-platform",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"demo-app\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Error ratio",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"demo-app\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"demo-app\"}[5m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latency p99",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"demo-app\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Saturation - in flight",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(http_requests_in_flight{job=\"demo-app\"})",
          "legendFormat": "in flight",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Traffic by route and status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(http_requests_total{job=\"demo-app\"}[5m]))",
          "legendFormat": "{{route}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Error ratio over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"demo-app\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"demo-app\"}[5m]))",
          "legendFormat": "error ratio",
          "refId": "A"
        },
        {
          "expr": "vector(0.005)",
          "legendFormat": "SLO threshold (0.5%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Latency quantiles",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"demo-app\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{job=\"demo-app\"}[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"demo-app\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "expr": "vector(0.25)",
          "legendFormat": "objective (250ms)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Error budget burn rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "demo_app:http_request_error_ratio:rate1h / 0.005",
          "legendFormat": "1h",
          "refId": "A"
        },
        {
          "expr": "demo_app:http_request_error_ratio:rate6h / 0.005",
          "legendFormat": "6h",
          "refId": "B"
        },
        {
          "expr": "demo_app:http_request_error_ratio:rate1d / 0.005",
          "legendFormat": "1d",
          "refId": "C"
        },
        {
          "expr": "vector(14.4)",
          "legendFormat": "page threshold",
          "refId": "D"
        },
        {
          "expr": "vector(1)",
          "legendFormat": "sustainable",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Database availability",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "min(app_database_up{job=\"demo-app\"})",
          "legendFormat": "db up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Database query latency p99",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(app_database_query_duration_seconds_bucket{job=\"demo-app\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Replicas",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_ready{deployment=\"demo-app\", namespace=\"demo\"}",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{deployment=\"demo-app\", namespace=\"demo\"}",
          "legendFormat": "desired",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Memory per pod",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"demo\", container=\"app\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "max(kube_pod_container_resource_limits{namespace=\"demo\", container=\"app\", resource=\"memory\"})",
          "legendFormat": "limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "CPU per pod",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"demo\", container=\"app\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "max(kube_pod_container_resource_requests{namespace=\"demo\", container=\"app\", resource=\"cpu\"})",
          "legendFormat": "request",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Container restarts",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"demo\", container=\"app\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}